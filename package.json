{
  "name": "creative-academy",
  "version": "0.1.0",
  "private": true,
  "description": "Creative Academy Batch Controller — live digital schedule display + built-in management API, all in one Next.js app.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build:shared",
    "dev": "next dev",
    "build:shared": "npm run build --workspace @academy/shared",
    "build": "npm run build:shared && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test --workspace @academy/shared && vitest run",
    "test:api": "vitest run"
  },
  "dependencies": {
    "@academy/shared": "*",
    "lucide-react": "^0.469.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "puppeteer-core": "^24.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}