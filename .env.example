# ------------------------------------------------------------------
# Copy to .env.local and adjust values.
# ------------------------------------------------------------------

# Academy branding shown on the display (defaults applied in app.config.ts)
NEXT_PUBLIC_ACADEMY_NAME=CREATIVE AI ACADEMY
NEXT_PUBLIC_TAGLINE=EDITING • DESIGN • AI

# Clock format: "12" (12-hour, default) or "24"
NEXT_PUBLIC_CLOCK_FORMAT=12

# API base. The API ships inside this Next.js app (route handlers under
# /api/*), so the default is the same-origin "/api" — no extra service needed.
#   • Unset        → use the built-in API at /api (default)
#   • Set to a URL → point the dashboard at a remote API host
#   • Set to ""    → force bundled mock data (no API calls)
NEXT_PUBLIC_API_URL=/api

# Allowed CORS origins for cross-origin API clients (comma separated).
# The dashboard itself is same-origin and never needs CORS.
CORS_ORIGINS=*

# (Future) Database connection when Prisma persistence is enabled
# DATABASE_URL=postgresql://user:password@localhost:5432/academy