# ------------------------------------------------------------------
# Copy to .env.local (frontend) / .env (API) and adjust values.
# ------------------------------------------------------------------

# ---------- Frontend (apps/web/.env.local) ----------
# Academy branding shown on the display (defaults applied in app.config.ts)
NEXT_PUBLIC_ACADEMY_NAME=CREATIVE AI ACADEMY
NEXT_PUBLIC_TAGLINE=EDITING • DESIGN • AI

# Clock format: "12" (12-hour, default) or "24"
NEXT_PUBLIC_CLOCK_FORMAT=12

# Optional: URL of the NestJS API (e.g. http://localhost:3001/api).
# When unset or unreachable, the dashboard falls back to bundled mock data.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ---------- Backend (apps/api/.env) ----------
API_PORT=3001
# Allowed CORS origins (comma separated)
CORS_ORIGINS=http://localhost:3000

# (Future) Database connection when Prisma persistence is enabled
# DATABASE_URL=postgresql://user:password@localhost:5432/academy